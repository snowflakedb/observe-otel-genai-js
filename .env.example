# OTLP exporter target (host app reads these; @genai-otel/bootstrap reads them too).
# Point at a local collector or any OTel-native backend.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>

# Resource attributes the bootstrap helper attaches.
OTEL_SERVICE_NAME=my-agent
OTEL_SERVICE_VERSION=0.1.0
OTEL_DEPLOYMENT_ENVIRONMENT_NAME=dev

# Integration-test gate (the OTLP smoke test only runs when both are set).
# OTLP_SMOKE_ENDPOINT=https://your-otlp-endpoint.example.com/v1/otel
# OTLP_SMOKE_TOKEN=<your-token>
