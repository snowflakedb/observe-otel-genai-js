# OTLP/HTTP endpoint for your OTel-native backend (Tempo, Honeycomb, Jaeger,
# Datadog, Observe, ...). Check your backend's OTLP setup guide for the URL.
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otlp-endpoint.example.com/v1/otel

# Auth header for the backend, if it requires one (format is backend-specific).
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <your-token>

# Identifies your data in the backend's resource attributes.
OTEL_SERVICE_NAME=observe-otel-genai-example
OTEL_RESOURCE_ATTRIBUTES=service.version=0.1.0,deployment.environment.name=dev
