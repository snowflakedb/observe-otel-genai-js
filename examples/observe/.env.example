# Observe OTLP endpoint — get this from the Observe portal under
# Settings → Account → API tokens (or the OTLP/HTTP setup guide).
OTEL_EXPORTER_OTLP_ENDPOINT=https://<your-customer-id>.collect.observeinc.com/v2/otel

# Bearer token from Observe.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <your-observe-token>

# Identifies your data in Observe's resource attributes.
OTEL_SERVICE_NAME=genai-otel-example
OTEL_SERVICE_VERSION=0.1.0
OTEL_DEPLOYMENT_ENVIRONMENT_NAME=dev
