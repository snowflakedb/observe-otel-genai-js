{
  "name": "@genai-otel/core",
  "version": "0.2.2",
  "description": "A lightweight, vendor-neutral OpenTelemetry wrapper for AI agents. Pure OTel emission with GenAI semantic-conventions support.",
  "license": "MIT",
  "author": "Snowflake Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowflake-eng/genai-otel.git"
  },
  "homepage": "https://github.com/snowflake-eng/genai-otel#readme",
  "bugs": "https://github.com/snowflake-eng/genai-otel/issues",
  "keywords": ["opentelemetry", "otel", "genai", "llm", "observability", "tracing", "ai-agents"],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap/index.d.ts",
      "import": "./dist/bootstrap/index.js",
      "require": "./dist/cjs/bootstrap/index.js"
    },
    "./vercel-ai-sdk": {
      "types": "./dist/integrations/vercel-ai-sdk/index.d.ts",
      "import": "./dist/integrations/vercel-ai-sdk/index.js",
      "require": "./dist/cjs/integrations/vercel-ai-sdk/index.js"
    },
    "./openai": {
      "types": "./dist/integrations/openai/index.d.ts",
      "import": "./dist/integrations/openai/index.js",
      "require": "./dist/cjs/integrations/openai/index.js"
    },
    "./anthropic": {
      "types": "./dist/integrations/anthropic/index.d.ts",
      "import": "./dist/integrations/anthropic/index.js",
      "require": "./dist/cjs/integrations/anthropic/index.js"
    },
    "./langchain": {
      "types": "./dist/integrations/langchain/index.d.ts",
      "import": "./dist/integrations/langchain/index.js",
      "require": "./dist/cjs/integrations/langchain/index.js"
    }
  },
  "files": ["dist", "docs", "LICENSE", "README.md"],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "clean": "rm -rf dist .test-dist",
    "sync-version": "node ./scripts/sync-version.mjs",
    "prebuild": "node ./scripts/sync-version.mjs",
    "pretest": "node ./scripts/sync-version.mjs",
    "build": "pnpm run clean && tsc --project tsconfig.build.json && node ./scripts/build-cjs.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=verbose",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0 <1",
    "@langchain/core": "^0.3.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.200.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.200.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "ai": "^7.0.0",
    "openai": "^4.0.0 || ^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@opentelemetry/context-async-hooks": {
      "optional": true
    },
    "@opentelemetry/exporter-metrics-otlp-http": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/sdk-metrics": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-node": {
      "optional": true
    },
    "@opentelemetry/semantic-conventions": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@biomejs/biome": "^1.9.4",
    "@langchain/core": "^0.3.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.205.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "@types/node": "^22.0.0",
    "ai": "^7.0.0",
    "esbuild": "^0.25.0",
    "openai": "^6.46.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  }
}
